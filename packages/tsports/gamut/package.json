    "lastUpdated": "2024-08-24T12:00:00Z"
  },
  "description": "TypeScript port of gamut with 100% API compatibility",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "moon run build",
    "clean": "moon run clean",
    "dev": "moon run dev",
    "test": "moon run test",
    "lint": "moon run lint",
    "format": "moon run format",
    "format:check": "dprint check",
    "prepack": "moon run prepack",
    "setup": "moon run setup",
    "version:bump-go": "moon run version-bump-go",
    "version:bump-tsport": "moon run version-bump-tsport"
  },
  "keywords": [
    "gamut",
    "go-port",
    "typescript"
  ],
  "author": {
    "name": "tsports",
    "url": "https://github.com/tsports"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TSports/termenv"
  },
  "bugs": {
    "url": "https://github.com/TSports/termenv/issues"
  },
  "homepage": "https://github.com/TSports/termenv#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "exports": {
    ".": {
