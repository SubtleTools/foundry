{
  "name": "@tsports/lipgloss",
  "version": "1.1.0",
  "goSourceVersion": "v1.1.0",
  "portInfo": {
    "sourceRepo": "https://github.com/charmbracelet/lipgloss",
    "sourceVersion": "v1.1.0",
    "tsportVersion": 0,
    "lastUpdated": "2024-08-24T02:30:00.000Z"
  },
  "description": "A comprehensive TypeScript port of Charm's Lipgloss terminal styling library with 100% API compatibility",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "imports": {
    "@/*": "./src/*",
    "@/index": "./src/index.ts",
    "@tsports/lipgloss": "./src/index.ts",
    "@tsports/lipgloss/*": "./src/*"
  },
  "scripts": {
    "build": "bun run build:rollup",
    "build:rollup": "rollup -c rollup.config.js",
    "test": "FORCE_COLOR=0 bun test test --timeout 300000",
    "test:watch": "FORCE_COLOR=0 bun test test --watch",
    "test:coverage": "FORCE_COLOR=0 bun test test --coverage --timeout 300000",
    "test:ci": "FORCE_COLOR=0 bun test test --timeout 600000",
    "test:examples": "FORCE_COLOR=0 bun test test/examples-comparison.test.ts --timeout 600000",
    "test:automation": "FORCE_COLOR=0 bun test test/automated-cases.test.ts --timeout 600000",
    "test:visual": "FORCE_COLOR=0 bun test test/visual-diff.test.ts --timeout 300000",
    "test:legacy": "bun run test/automation/main.ts test --verbose",
    "lint": "eslint src test examples --ext .ts,.tsx --max-warnings=500",
    "lint:fix": "eslint src test examples --ext .ts,.tsx --fix",
    "format": "prettier --write \"{src,test,examples}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{src,test,examples}/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "dev": "bun run build:watch",
    "dev:examples": "bun run examples/layout/main.ts",
    "clean": "rm -rf dist .tsbuildinfo docs/.vitepress/dist",
    "validate": "bun run format:check && bun run type-check && bun run test",
    "validate:full": "bun run format:check && bun run lint && bun run type-check && bun run test",
    "ci": "bun run clean && bun run validate && bun run build",
    "examples": "bun run examples:all",
    "examples:list": "echo \"List Examples:\" && for f in examples/list/*/main.ts; do echo \"Running $f:\"; bun \"$f\"; echo; done",
    "examples:table": "echo \"Table Examples:\" && for f in examples/table/*/main.ts; do echo \"Running $f:\"; bun \"$f\"; echo; done",
    "examples:tree": "echo \"Tree Examples:\" && for f in examples/tree/*/main.ts; do echo \"Running $f:\"; bun \"$f\"; echo; done",
    "examples:layout": "echo \"Layout Example:\" && bun examples/layout/main.ts",
    "examples:ssh": "echo \"SSH Example:\" && bun examples/ssh/main.ts",
    "examples:all": "bun run examples:layout && bun run examples:list && bun run examples:table && bun run examples:tree && bun run examples:ssh",
    "benchmark": "echo 'Benchmark example was moved/removed - use specific examples instead'",
    "golden:setup": "bun run scripts/golden-setup.ts",
    "golden:update": "bun run scripts/golden-update.ts",
    "docs:api": "typedoc --out docs/api src/index.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check-links": "bun run docs:build && echo 'Built docs successfully - link check will run in CI'",
    "apply-patch": "git apply changes.patch --directory=test/automation/reference",
    "prepublishOnly": "bun run ci",
    "version:bump-go": "moon run version-bump-go",
    "version:bump-tsport": "moon run version-bump-tsport"
  },
  "keywords": [
    "terminal",
    "cli",
    "styling",
    "ansi",
    "colors",
    "typescript",
    "lipgloss",
    "charm",
    "tsports",
    "tui",
    "layout",
    "borders",
    "components"
  ],
  "author": "tsports Team",
  "license": "MIT",
  "homepage": "https://tsports.github.io/lipgloss",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsports/lipgloss.git"
  },
  "bugs": {
    "url": "https://github.com/tsports/lipgloss/issues"
  },
  "dependencies": {
    "@tsports/go-colorful": "workspace:*",
    "@tsports/termenv": "workspace:*",
    "@tsports/uniseg": "workspace:*",
    "color-convert": "^3.1.0",
    "colord": "^2.9.3",
    "supports-color": "^9.4.0",
    "type-fest": "^4.41.0"
  },
  "devDependencies": {
    "@tsports/gamut": "workspace:*",
    "@types/chroma-js": "^3.1.1",
    "@types/diff": "^8.0.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "ansi-escapes": "^7.0.0",
    "ansi-regex": "^6.2.0",
    "chroma-js": "^3.1.2",
    "diff": "^8.0.2",
    "eastasianwidth": "^0.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "rollup": "^4.13.0",
    "rollup-plugin-dts": "^6.1.0",
    "rollup-plugin-esbuild": "^6.1.1",
    "terminal-size": "^4.0.0",
    "typedoc": "^0.28.10",
    "typedoc-plugin-extras": "^4.0.1",
    "typedoc-plugin-markdown": "^4.8.1",
    "typedoc-plugin-mdn-links": "^5.0.9",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typedoc-plugin-missing-exports": "^4.1.0",
    "typescript": "^5.4.2",
    "unicode-width": "^0.2.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.18"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
